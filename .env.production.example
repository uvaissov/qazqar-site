# QazQar Site — шаблон прод/стейджинг .env (на сервере лежит как /opt/qazqar/.env).
# Реальные значения генерируются при деплое; внешние (Yume/SMTP) переносятся из рабочего .env.

# --- БД (Postgres в compose, хост = имя сервиса) ---
POSTGRES_PASSWORD=__generated__
DATABASE_URL=postgresql://qazqar:__generated__@postgres:5432/qazqar

# --- Auth ---
JWT_SECRET=__generated__
NODE_ENV=production

# --- MinIO (в compose, хост = имя сервиса; ключи = root user/pass) ---
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=__generated__
MINIO_SECRET_KEY=__generated__
MINIO_BUCKET=qazqar-images
# Публичный URL картинок (nginx проксирует /qazqar-images/ → MinIO). Инлайнится в билд!
NEXT_PUBLIC_MINIO_URL=https://qazqar.d3v.kz/qazqar-images
NEXT_PUBLIC_APP_URL=https://qazqar.d3v.kz

# --- Yume Cloud CRM (переносятся из рабочего .env) ---
YUME_API_URL=https://api.yume.cloud
YUME_ORIGIN=https://qazqar.yume.cloud
YUME_USERNAME=
YUME_PASSWORD=
YUME_INVENTORIZATION_STATE_OK=
YUME_INVENTORIZATION_STATE_BROKEN=

# --- SMTP (стейджинг = mailhog в compose; UI на 127.0.0.1:8025) ---
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=noreply@qazqar.kz

# --- SMS / GSM-шлюз (отложено; на стейджинге НЕ задаём) ---
# GSM_GATEWAY_HOST=
# GSM_GATEWAY_AMI_PORT=
# ...
# GSM-шлюз TG100 (SMS на автопульт). Транспорт — AMI, порт 5038 (дефолт в коде).
# В whitelist на странице AMI шлюза должна быть подсеть сервера, иначе логин
# отбивается как "Authentication failed" — неотличимо от неверного пароля.
GSM_GATEWAY_HOST=192.168.0.150
GSM_GATEWAY_ACCOUNT=apiuser
GSM_GATEWAY_PASSWORD=apipass
GSM_GATEWAY_SPAN=2
